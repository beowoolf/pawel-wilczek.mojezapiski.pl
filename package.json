{
  "name": "pawel-wilczek.mojezapiski.pl",
  "version": "1.0.0",
  "description": "Wizytówka internetowa Pawła Wilczka",
  "author": "Paweł Wilczek",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node app.js",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\" --ignore-path .gitignore",
    "lint:prettier": "prettier --check .",
    "lint": "yarn lint:js && yarn lint:style && yarn lint:prettier",
    "lintfix": "prettier --write --list-different . && yarn lint:js --fix && yarn lint:style --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:basic": "yarn && yarn lint && yarn test",
    "ci": "yarn ci:basic && yarn build"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "eslint --cache",
    "*.{css,scss,sass,html,vue}": "stylelint",
    "*.**": "prettier --check --ignore-unknown"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sitemap": "^8.6.2",
    "@vite-pwa/nuxt": "^2.0.1",
    "better-sqlite3": "^13.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "nuxt": "4.4.8",
    "nuxt-gtag": "^5.0.0",
    "nuxt-seo-experiments": "^4.0.1",
    "@img/sharp-wasm32": "0.35.5",
    "sharp": "^0.35.5",
    "vue": "^3.5.45",
    "vue-router": "5.5.0"
  },
  "optionalDependencies": {
    "@img/sharp-freebsd-wasm32": "0.35.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-dom": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
